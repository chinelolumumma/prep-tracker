rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Each person's pointer to their household. Only they can see it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // Start a household with only yourself in it.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Members can see, change and delete their household.
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      // Members can edit; someone holding the invite link can add only themselves.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
      );

      // Names of the people in the household. Members can see everyone; each person edits only their own entry.
      match /members/{memberId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && request.auth.uid == memberId;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      // The stock list: household members only.
      match /items/{itemId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
